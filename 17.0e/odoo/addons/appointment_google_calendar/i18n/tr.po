#, python-format
msgid ""
"%(user_names)s did not synchronize their Google Calendar account yet, Google "
"Meeting links won't be added to their meetings."
msgstr ""
"%(user_names)s henüz Google Takvim hesaplarıyla senkronize edilmediğinden, "
"Google Toplantı bağlantıları toplantılarına eklenmeyecektir."

