#. module: industry_fsm_sale
#. odoo-javascript
#: code:addons/industry_fsm_sale/static/src/js/tours/industry_fsm_sale_tour.js:0
#, python-format
msgid "<b>Invoice your time and material</b> to your customer."
msgstr "<b>Фактурирайте вашето време и материали</b> на вашия клиент."

#. module: industry_fsm_sale
#. odoo-python
#: code:addons/industry_fsm_sale/models/project_task.py:0
#, python-format
msgid ""
"<p class=\"o_view_nocontent_smiling_face\">\n"
"                            No products found. Let's create one!\n"
"                        </p><p>\n"
"                            Keep track of the products you are using to "
"complete your tasks, and invoice your customers for the goods.\n"
"                            Tip: using kits, you can add multiple products "
"at once.\n"
"                        </p><p>\n"
"                            When your task is marked as done, your stock "
"will be updated automatically. Simply choose a warehouse\n"
"                            in your profile from where to draw stock.\n"
"                        </p>"
msgstr ""
"<p class=\"o_view_nocontent_smiling_face\">\n"
"                            Няма намерени продукти. Нека създадем един!\n"
"                        </p><p>\n"
"                            Следете продуктите, които използвате за "
"изпълнение на вашите задачи, и фактурирайте стоките на вашите клиенти.\n"
"                            Съвет: с помощта на комплекти можете да добавите "
"няколко продукта наведнъж.\n"
"                        </p><p>\n"
"                            Когато задачата ви е маркирана като завършена, "
"наличността ви ще се обнови автоматично. Просто изберете склад\n"
"                            в профила си, от който да се изтегли "
"наличността.\n"
"                        </p>"

