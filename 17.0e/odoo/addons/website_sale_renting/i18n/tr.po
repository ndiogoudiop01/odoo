#, python-format
msgid ""
"\n"
"                The new period is not valid for some products of your cart.\n"
"                Your changes on the rental period are not taken into "
"account.\n"
"            "
msgstr ""

#. module: website_sale_renting
#. odoo-python
#: code:addons/website_sale_renting/models/sale_order.py:0
#, python-format
msgid ""
"\n"
"                Your rental duration was too short. Unfortunately, we do not "
"process\n"
"                rentals that last less than %(duration)s %(unit)s.\n"
"            "
msgstr ""
"\n"
"                Kiralama süreniz çok kısaydı. Maalesef, %(duration)s %(unit)"
"s'den daha kısa süren kiralamaları işleme alamıyoruz\n"
"            "

#. module: website_sale_renting
#. odoo-python
#: code:addons/website_sale_renting/models/sale_order.py:0
#, python-format
msgid ""
"\n"
"                Your rental product had invalid date of pickup "
"(%(start_date)s).\n"
"                Unfortunately, we do not process pickups on that weekday.\n"
"            "
msgstr ""
"\n"
"                Kiralama ürününüzün geçersiz bir teslim alma tarihi (%"
"(start_date)s) vardı. Maalesef, o hafta içi (gün) teslim alma işlemlerini "
"gerçekleştiremiyoruz\n"
"            "

#. module: website_sale_renting
#. odoo-python
#: code:addons/website_sale_renting/models/sale_order.py:0
#, python-format
msgid ""
"\n"
"                Your rental product had invalid date of return "
"(%(end_date)s).\n"
"                Unfortunately, we do not process returns on that weekday.\n"
"            "
msgstr ""
"\n"
"                Kiralama ürününüzün geçersiz bir iade tarihi (%(end_date)s) "
"vardı. Maalesef, o hafta içi (gün) iade işlemlerini gerçekleştiremiyoruz\n"
"            "

#. module: website_sale_renting
#. odoo-python
#: code:addons/website_sale_renting/models/sale_order.py:0
#, python-format
msgid ""
"\n"
"                Your rental product had invalid dates of pickup "
"(%(start_date)s) and\n"
"                return (%(end_date)s). Unfortunately, we do not process "
"pickups nor\n"
"                returns on those weekdays.\n"
"            "
msgstr ""
"\n"
"                Kiralama ürününüzün geçersiz teslim alma (%(start_date)s) ve "
"iade (%(end_date)s) tarihleri vardı. Maalesef, o hafta içi günlerde ne "
"teslim alma ne de iade işlemlerini gerçekleştirebiliyoruz.\n"
"            "

#. module: website_sale_renting
#. odoo-python
#: code:addons/website_sale_renting/models/sale_order.py:0
#, python-format
msgid ""
"\n"
"            Some of your rental products (%(product)s) cannot be rented "
"during the\n"
"            selected period and your cart must be updated. We're sorry for "
"the\n"
"            inconvenience.\n"
"        "
msgstr ""
"\n"
"            Kiralama ürünlerinizden bazıları (%(product)s), seçilen süre "
"boyunca kiralanamamaktadır ve sepetinizin güncellenmesi gerekmektedir. "
"Verdiğimiz rahatsızlıktan dolayı özür dileriz.\n"
"        "

